@model IEnumerable<Sahayee.Models.DB.News>
<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Country</th>
            <th>Type</th>
            <th>Summary</th>
            <th>Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var job in Model)
        {
            <tr>
                <td>@job.Title</td>
                <td>@job.Country</td>
                <td>@job.TypeId</td>
                <td>@job.Summary</td>
                <td>@job.NewsDate</td>
                <td>
                    <a href="/News/Create?id=@job.Id" class="btn btn-primary text-white !bg-[#54a8c7] border-[#54a8c7] hover:text-white hover:bg-[#54a8c7] hover:border-[#54a8c7] focus:shadow-[rgba(79,152,181,1)] focus:text-white active:text-white active:bg-[#54a8c7] active:border-[#54a8c7] disabled:text-white disabled:bg-[#54a8c7] disabled:border-[#54a8c7] !rounded-[50rem] btn-login w-full mb-2">Edit</a>
                    @*<a href="/Job/AdminApplicantDetails?jobAId=@job.Id" class="btn btn-warning">Details</a>*@
                    @*<button class="btn btn-danger" onclick="openDeleteModal('@job.Id')">Delete</button>*@
                </td>
            </tr>
        }
    </tbody>
</table>
