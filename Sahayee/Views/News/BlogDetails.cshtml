@model Sahayee.Models.ViewModel.BlogViewModel
<section class="wrapper !bg-[#edf2fc]">
    <div class="container pt-10 pb-36 xl:pt-[4.5rem] lg:pt-[4.5rem] md:pt-[4.5rem] xl:pb-40 lg:pb-40 md:pb-40 !text-center">
        <div class="flex flex-wrap mx-[-15px]">
            <div class="md:w-10/12 lg:w-10/12 xl:w-8/12 w-full flex-[0_0_auto] px-[15px] max-w-full !mx-auto">
                <div class="post-header !mb-[.9rem]">
                    <div class="inline-flex uppercase tracking-[0.02rem] text-[0.7rem] font-bold text-[#aab0bc] mb-[0.4rem]  text-line relative align-top pl-[1.4rem] before:content-[''] before:absolute before:inline-block before:translate-y-[-60%] before:w-3 before:h-[0.05rem] before:left-0 before:top-2/4 before:bg-[#3f78e0]">
                        <a href="#" class="hover" rel="category">@Model.Selected.TypeId</a>
                    </div>
                    <!-- /.post-category -->
                    <h1 class="text-[calc(1.365rem_+_1.38vw)] font-bold leading-[1.2] xl:text-[2.4rem] mb-4">@Model.Selected.Title</h1>
                    <ul class="text-[0.8rem] text-[#aab0bc] m-0 p-0 list-none !mb-5">
                        <li class="post-date inline-block"><i class="uil uil-calendar-alt pr-[0.2rem] align-[-.05rem] before:content-['\e9ba']"></i><span>@Model.Selected.NewsDate</span></li>
                    </ul>
                    <a asp-controller="News"
                       asp-action="Blog">All News</a>
                    <!-- /.post-meta -->
                </div>
                <!-- /.post-header -->
            </div>
            <!-- /column -->
        </div>
        <!-- /.row -->
    </div>
    <!-- /.container -->
</section>

<section class="wrapper !bg-[#ffffff]">
    <div class="container !pb-[4.5rem] xl:!pb-24 lg:!pb-24 md:!pb-24">
        <div class="flex flex-wrap mx-[-15px]">
            <div class="xl:w-10/12 lg:w-10/12 w-full flex-[0_0_auto] px-[15px] max-w-full !mx-auto">
                <div class="blog single !mt-[-7rem]">
                    <div class="card">
                        <figure class="card-img-top"><img src="~/uploads/@Model.Selected.image" alt="image"></figure>
                        <div class="card-body flex-[1_1_auto] p-[40px] xl:p-[2.8rem_3rem_2.8rem] lg:p-[2.8rem_3rem_2.8rem] md:p-[2.8rem_3rem_2.8rem]">
                            <div class="classic-view">
                                <article class="post mb-8">
                                    <div class="relative mb-5">
                                        <h2 class="h1 !mb-4 !leading-[1.3]">@Model.Selected.Title</h2>
                                        <p>@Model.Selected.Summary</p>
                                        <p>@Model.Selected.Content</p>
                                    </div>
                                </article>
                                <!-- /.post -->
                            </div>
                            <!-- /.classic-view -->
                            <hr>

                            <!-- /.social -->
                            <hr>
                            <h3 class="!mb-6">You Might Also Like</h3>
                            <div class="swiper-container blog grid-view mb-24 relative z-10" data-margin="30" data-dots="true" data-items-md="2" data-items-xs="1">
                                <div class="swiper">
                                    <div class="swiper-wrapper">

                                        @foreach (var item in Model.News)
                                        {
                                            <div class="swiper-slide">
                                                <article>
                                                    <figure class="overlay overlay-1 hover-scale group rounded !mb-5">
                                                        <a asp-controller="News"
                                                       asp-action="BlogDetails"
                                                       asp-route-id="@item.Id"> <img class="!transition-all !duration-[0.35s] !ease-in-out group-hover:scale-105" src="~/uploads/@item.image" alt="image"></a>
                                                        <figcaption class="group-hover:opacity-100 absolute w-full h-full opacity-0 text-center px-4 py-3 inset-0 z-[5] pointer-events-none p-2">
                                                            <a asp-controller="News"
                                                           asp-action="BlogDetails"
                                                           asp-route-id="@item.Id"> <h5 class="from-top  !mb-0 absolute w-full translate-y-[-80%] p-[.75rem_1rem] left-0 top-2/4">Read More</h5></a>
                                                        </figcaption>
                                                    </figure>
                                                    <div class="post-header !mb-[.9rem]">
                                                        <div class="inline-flex mb-[.4rem] uppercase tracking-[0.02rem] text-[0.7rem] font-bold text-[#aab0bc] relative align-top pl-[1.4rem] before:content-[''] before:absolute before:inline-block before:translate-y-[-60%] before:w-3 before:h-[0.05rem] before:left-0 before:top-2/4 before:bg-[#3f78e0]">
                                                            <a href="#" class="hover" rel="category">@item.TypeId</a>
                                                        </div>
                                                        <!-- /.post-category -->
                                                        <h2 class="post-title h3 !mt-1 !mb-3">
                                                            <a class="text-[#343f52] hover:text-[#3f78e0]" asp-controller="News"
                                                           asp-action="BlogDetails"
                                                           asp-route-id="@item.Id">@item.Title</a>
                                                        </h2>
                                                    </div>
                                                    <!-- /.post-header -->
                                                    <div class="post-footer">
                                                        <ul class="text-[0.7rem] text-[#aab0bc] m-0 p-0 list-none  !mb-0">
                                                            <li class="post-date inline-block"><i class="uil uil-calendar-alt pr-[0.2rem] align-[-.05rem] before:content-['\e9ba']"></i><span>@item.NewsDate</span></li>
                                                            <li class="post-comments inline-block before:content-[''] before:inline-block before:w-[0.2rem] before:h-[0.2rem] before:opacity-50 before:m-[0_.6rem_0] before:rounded-[100%] before:align-[.15rem] before:bg-[#aab0bc]"><a class="text-[#aab0bc] hover:text-[#3f78e0] hover:border-[#3f78e0]" href="#"><i class="uil uil-comment pr-[0.2rem] align-[-.05rem] before:content-['\ea54']"></i>4</a></li>
                                                        </ul>
                                                        <!-- /.post-meta -->
                                                    </div>
                                                    <!-- /.post-footer -->
                                                </article>
                                                <!-- /article -->
                                            </div>


                                        }

                                        <!--/.swiper-slide -->
                                    </div>
                                    <!--/.swiper-wrapper -->
                                </div>
                                <!-- /.swiper -->
                            </div>
                            <!-- /.swiper-container -->
                            <!-- /.comment-form -->
                        </div>
                        <!-- /.card-body -->
                    </div>
                    <!-- /.card -->
                </div>
                <!-- /.blog -->
            </div>
            <!-- /column -->
        </div>
        <!-- /.row -->
    </div>
    <!-- /.container -->
</section>