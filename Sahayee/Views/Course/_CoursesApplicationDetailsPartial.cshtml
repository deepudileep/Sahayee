@model Sahayee.Models.ViewModel.CourseApplicationDetailsViewModel

@if (Model.CourseApplicationWithDetails.Any())
{

    <div class="md:w-12/12 lg:w-12/12 xl:w-12/12 w-full ">
        @foreach (var course in Model.CourseApplicationWithDetails)
        {


            <h2 class="text-[calc(1.265rem_+_0.18vw)] font-bold xl:text-[1.4rem] leading-[1.35] mb-2">@course.CourseDetails.CourseTitle</h2>
            <a asp-controller="Course" asp-action="DetailsView" asp-route-id="@course.CourseDetails.Id" class="more hover">See Course Details</a>
            <div style="height:10px"></div>
            <div class="flex flex-wrap mx-0">
                <div class="xl:w-9/12 lg:w-9/12 md:w-9/12 w-full flex-[0_0_auto] max-w-full">
                    <p>@course.CourseDetails.CourseOverview</p>
                </div>
                <!--/column -->
                <div class="xl:w-3/12 lg:w-3/12 md:w-3/12 w-full flex-[0_0_auto] max-w-full !ml-auto">

                    <ul class="pl-0 list-none">
                        <li>
                            <h5 class="!mb-1">Date</h5>
                            <p>@course.CourseDetails.StartDate</p>
                        </li>
                        <li>
                            <h5 class="!mb-1">Course Category</h5>
                            <p>@course.CourseDetails.Category</p>
                        </li>
                        <li>
                            <h5 class="!mb-1">Course Type</h5>
                            <p>@course.CourseDetails.CourseType</p>
                        </li>
                    </ul>

                </div>
                <div class="xl:w-9/12 lg:w-9/12 md:w-9/12 w-full flex-[0_0_auto] max-w-full">
                    <h4>Message from Applicant:</h4>
                    <ul class="pl-0 list-none">
                        @if (course.FollowUpHistory != null && course.FollowUpHistory.Count > 0)
                        {
                            if (!string.IsNullOrEmpty(course.FollowUpHistory.Last().AdminNotes))
                            {
                                <li>
                                    <p>@course.FollowUpHistory.Last().AdminNotes</p>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <p>No message available.</p>
                                </li>
                            }
                        }
                        else
                        {
                            <li>
                                <p>No message available.</p>
                            </li>
                        }
                    </ul>
                </div>
                <!--/column -->
            </div>
            <!--/.row -->
            <!-- /column -->
        }
    </div>
}
else
{
    <div class="flex flex-wrap mx-[-15px]">
        <div class="alert alert-warning" role="alert">
            No applications available.
        </div>
    </div>
}



