</section>
<script>
    function onCourseTypeChange(selectedValue) {

        // Construct the URL to call the Courses action method

        const url = `/Course/Courses?category=all&location=${selectedValue}&institution=all`;
        // Redirect to the URL
        window.location.href = url;
    }

    function onInstitutionsChange(selectedValue) {

        // Construct the URL to call the Courses action method
        const url = `/Course/Courses?category=all&location=all&institution=${selectedValue}`;

        // Redirect to the URL
        window.location.href = url;
    }

    function onCategoriesChange(selectedValue) {

        // Construct the URL to call the Courses action method
        const url = `/Course/Courses?category=${selectedValue}&location=all&institution=all`;
        // Redirect to the URL
        window.location.href = url;
    }
    function onLocationInputBlur(selectedValue) {
        if (selectedValue.trim() !== "") { // Ensure input is not empty
            const url = `/Course/Courses?category=all&location=all&institution=all&title=${selectedValue}`;
            window.location.href = url;
        }
    }
</script>