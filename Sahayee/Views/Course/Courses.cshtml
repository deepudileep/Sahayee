                <!-- /.widget -->
                <!-- /.widget -->
            </aside>
            <div class="xl:w-9/12 lg:w-9/12 w-full flex-[0_0_auto] px-[15px] max-w-full xl:!order-2 lg:!order-2 mt-[50px]">
                <div class="flex flex-wrap mx-[-15px] items-center mb-10 !relative z-[1]">
                    <div class="md:w-7/12 lg:w-7/12 xl:w-8/12 w-full flex-[0_0_auto] px-[15px] max-w-full xl:pr-40">

                        <p class="mb-0 text-[#aab0bc]"> @Model.Courses.Count results</p>
                        @{
                            var category = Context.Request.Query["category"];
                            var location = Context.Request.Query["location"];
                            var institution = Context.Request.Query["institution"];
                            var title = Context.Request.Query["title"];


                            @if (!string.IsNullOrEmpty(category) && category != "all")
                            {
                                <p class="mb-0 text-[#aab0bc]">
                                    Category: @category
                                </p>
                            }

                            @if (!string.IsNullOrEmpty(location) && location != "all")
                            {
                                <p class="mb-0 text-[#aab0bc]">
                                    CourseType: @location
                                </p>
                            }

                            @if (!string.IsNullOrEmpty(institution) && institution != "all")
                            {
                                <p class="mb-0 text-[#aab0bc]">
                                    Institution: @Model.Institutions?.FirstOrDefault()?.Name
                                </p>
                            }
                            @if (!string.IsNullOrEmpty(title))
                            {
                                <p class="mb-0 text-[#aab0bc]">
                                    Keyname: @title
                                </p>
                            }
                        }
                    </div>
                    <!--/column -->
                    <div class="md:w-5/12 lg:w-5/12 xl:w-4/12 w-full flex-[0_0_auto] px-[15px] max-w-full xl:!ml-auto lg:!ml-auto md:!ml-auto xl:!text-right lg:!text-right md:!text-right mt-5 xl:!mt-0 lg:!mt-0 md:!mt-0">
                        @*<div class="form-select-wrapper">
                        <select class="form-select">
                        <option value="popularity">Sort by popularity</option>
                        <option value="rating">Sort by average rating</option>
                        <option value="newness">Sort by newness</option>
                        <option value="price: low to high">Sort by price: low to high</option>
                        <option value="price: high to low">Sort by price: high to low</option>
                        </select>
                        </div>*@
                        <!--/.form-select-wrapper -->
                    </div>

                    <!--/column -->
                </div>
                <div class="flex flex-wrap mx-[-15px] items-center mb-10 !relative z-[1]">
                    @await Html.PartialAsync("_CoursesPartial", Model)
                </div>
                <nav class="flex" aria-label="pagination">
                    <ul class="pagination">
                        @if (Model.CurrentPage > 1)
                        {
                            <li class="page-item">

                                <a class="page-link" asp-action="Courses" asp-route-pageNumber="@(Model.CurrentPage - 1)" aria-label="Previous">
                                    <span aria-hidden="true"><i class="uil uil-arrow-left before:content-['\e949']"></i></span>
                                </a>

                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">

                                <a class="page-link" href="#" aria-label="Previous">
                                    <span aria-hidden="true"><i class="uil uil-arrow-left before:content-['\e949']"></i></span>
                                </a>

                            </li>

                        }
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == Model.CurrentPage)
                            {
                                <li class="page-item active"><a class="page-link" href="#">@i</a></li>
                            }
                            else
                            {
                                <li class="page-item"><a class="page-link" asp-action="Courses" asp-route-pageNumber="@(Model.CurrentPage + 1)">@i</a></li>
                            }
                        }
                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Courses" asp-route-pageNumber="@(Model.TotalPages - 1)" aria-label="Next">
                                    <span aria-hidden="true"><i class="uil uil-arrow-right before:content-['\e94c']"></i></span>
                                </a>
                            </li>
                        }

                    </ul>


