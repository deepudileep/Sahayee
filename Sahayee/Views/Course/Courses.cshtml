                                </div>

                            </div>
                        </li>
                        <li class="!mb-1">
                            <a href="#" class="items-center rounded text-[#60697b]" data-bs-toggle="collapse" data-bs-target="#clothing-collapse" aria-expanded="true">
                                Course Type <span class="text-[0.7rem] text-[#aab0bc] ml-1">(@Model.CourseType.Count)</span>
                            </a>
                            <div class="collapse show mt-1" id="clothing-collapse" style="">
                                <div class="form-select-wrapper mb-4">
                                    <select id="ddlCourseType"
                                            onchange="onCourseTypeChange(this.value)"
                                            asp-items="@(new SelectList(Model.CourseType, "Id", "Name",Model.CourseTypeId))"
                                            class="form-select">
                                    </select>

                                </div>

                            </div>
                        </li>
                        <li class="!mb-1">
                            <a href="#" class="items-center rounded text-[#60697b]" data-bs-toggle="collapse" data-bs-target="#clothing-collapse" aria-expanded="true">
                                Institutions <span class="text-[0.7rem] text-[#aab0bc] ml-1">(@Model.Institutions?.Count)</span>
                            </a>
                            <div class="collapse show mt-1" id="clothing-collapse" style="">
                                <select id="ddlInst"
                                        onchange="onInstitutionsChange(this.value)"
                                        asp-items="@(new SelectList(Model.Institutions, "Id", "Name",Model.InstitutionsId))"
                                        class="form-select">
                                </select>

                            </div>
                        </li>
                        <li class="!mb-1">
                            <a href="#" class="items-center rounded text-[#60697b]" data-bs-toggle="collapse" data-bs-target="#clothing-collapse" aria-expanded="true">
                                Categories <span class="text-[0.7rem] text-[#aab0bc] ml-1">(@Model.Categories.Count)</span>
                            </a>
                            <div class="collapse show mt-1" id="clothing-collapse" style="">
                                <select id="ddlCategory"
                                        onchange="onCategoriesChange(this.value)"
                                        asp-items="@(new SelectList(Model.Categories, "Id", "Name",Model.CategoryId))"
                                        class="form-select">
                                </select>

                            </div>
                        </li>
                    </ul>
                </div>
