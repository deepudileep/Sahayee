@model Sahayee.Models.ViewModel.AdminDashCount
@{
    Layout = "_LayoutAdmin";
}
<div class="row">
    @{
        string[] cardClasses = new string[] { "bg-primary", "bg-success", "bg-warning" };
    }

    @foreach (var (item, index) in Model.DashItems.Select((value, index) => (value, index)))
    {
        // Get the class based on the index, loop back to the start if we exceed the number of classes
        var cardClass = cardClasses[index % cardClasses.Length];
        <div class="col-md-4 grid-margin grid-margin-md-0 stretch-card">
            <div class="card border-0 @cardClass text-white">
                <div id="downloads-carousel" class="carousel slide card-carousel" data-ride="carousel">
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <div class="card-body pb-0">
                                <p class="card-title text-white">@item.Title</p>
                                <h1>@item.ActiveCount</h1>
                                <div style="height:10px"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

</div>
<div class="row">
    @foreach (var item in Model.LatestItems)
    {
        <div class="col-md-4 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">@item.Title</h4>
                    @*<div class="media">
                <i class="mdi mdi-earth icon-md text-info d-flex align-self-start me-3"></i>
                <div class="media-body">
                <p class="card-text">Cras sit amet nibh libero, in gravida nulla. Nulla vel metus scelerisque.</p>
                </div>
                </div>*@
                </div>
            </div>
        </div>
    }

</div>