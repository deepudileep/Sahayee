<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>

    function validatePassword() {
        var password = document.getElementById("loginpassword").value;
        var confirmPassword = document.getElementById("loginpasswordconfirm").value;
        var errorDiv = document.getElementById("passwordError");

        if (password !== confirmPassword) {
            errorDiv.classList.remove("hidden"); // Show error message
            return false; // Prevent form submission
        } else {
            errorDiv.classList.add("hidden"); // Hide error message
            return true; // Allow form submission
        }
    }

    function validateEmail() {
        var email = document.getElementById("loginEmail").value;
        var emailError = document.getElementById("emailError");

        if (email.length > 0) {
            // Disable email error when the user is typing
            emailError.classList.add("hidden");

            // Perform AJAX request to check email existence
            $.ajax({
                url: "/User/CheckEmailExist",
                type: "POST",
                data: { email: email },
                success: function (response) {
                    if (response.exists) {
                        emailError.classList.remove("hidden"); // Show error message
                        emailError.textContent = "Email is already registered"; // Set error message
                    } else {
                        emailError.classList.add("hidden"); // Hide error message
                        // Submit the form via JavaScript if email is valid
                        document.getElementById("registrationForm").submit();
                    }
                },
                error: function () {
                    console.error("Error checking email");
                }
            });
        } else {
            // If the email is empty, hide the error message
            emailError.classList.add("hidden");
            return true; // Allow form submission
        }
    }

    function validateForm() {
        var isPasswordValid = validatePassword();
        var isEmailValid = validateEmail();

        // If password and email are valid, trigger the email validation AJAX request
        if (isPasswordValid && isEmailValid) {
            // Return false to prevent default form submission so AJAX can complete
            return false;
        } else {
            // If validation fails, prevent form submission
            return false;
        }
    }

    function validateEmailPass() {
        var email = document.getElementById("username").value;
        var password = document.getElementById("password").value;

        var emailError = document.getElementById("userError");

        if (email.length > 0) {
            // Disable email error when the user is typing
            emailError.classList.add("hidden");

            // Perform AJAX request to check email existence
            $.ajax({
                url: "/User/CheckEmailPassExist",
                type: "POST",
                data: { email: email, pass: password },
                success: function (response) {

                    if (response.exists) {
                        emailError.classList.add("hidden");
                        document.getElementById("loginForm").submit();
                    }
                    else {
                        emailError.classList.remove("hidden");
                    }
                },
                error: function () {
                    console.error("Error checking email");
                }
            });
        } else {
            // If the email is empty, hide the error message
            emailError.classList.add("hidden");
            return true; // Allow form submission
        }
    }
    function validateSignForm() {

        var isEmailValid = validateEmailPass();

        // If password and email are valid, trigger the email validation AJAX request
        if (isEmailValid) {
            // Return false to prevent default form submission so AJAX can complete
            return false;
        } else {
            // If validation fails, prevent form submission
            return false;
        }
    }

</script>