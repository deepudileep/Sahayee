@model Sahayee.Models.ViewModel.OrganizationDetailsViewModel

@{
    Layout = "_LayoutAdmin";
}

<!-- /section -->
<div class="row">
        <div class="flex flex-wrap mx-[-15px] md:mx-[-20px] lg:mx-[-20px] xl:mx-[-35px] mt-[-40px]">
            <div class="xl:w-6/12 lg:w-6/12 w-full flex-[0_0_auto] px-[15px] xl:px-[35px] lg:px-[20px] mt-[40px] max-w-full">
                <div class="swiper-container swiper-thumbs-container" data-margin="10" data-dots="false" data-nav="true" data-thumbs="true">
                    <div class="swiper">
                        <div class="swiper-wrapper">
                            <div class="swiper-slide group">
                                <figure class="rounded-[0.4rem]"><img class="rounded-[0.4rem]" src="~/uploads/@Model.Organization.ImagePath" srcset="~/uploads/@Model.Organization.ImagePath 2x" alt="image"><a class="item-link absolute w-[2.2rem] h-[2.2rem] leading-[2.2rem] z-[1] transition-all duration-[0.3s] ease-in-out opacity-0 text-[#343f52] shadow-[0_0.25rem_0.75rem_rgba(30,34,40,0.02)] text-[1rem] flex items-center justify-center rounded-[100%] right-0 bottom-4 bg-[rgba(255,255,255,.7)] hover:bg-[rgba(255,255,255,.9)] hover:!text-[#343f52] group-hover:opacity-100 group-hover:right-[1rem]" href="./assets/img/photos/shs1@2x.jpg" data-glightbox data-gallery="product-group"><i class="uil uil-focus-add before:content-['\eb22']"></i></a></figure>
                            </div>
                            <!--/.swiper-slide -->
                            <div class="swiper-slide group">
                                <figure class="rounded-[0.4rem]"><img class="rounded-[0.4rem]" src="~/uploads/@Model.Organization.ImagePath" srcset="~/uploads/@Model.Organization.ImagePath 2x" alt="image"><a class="item-link absolute w-[2.2rem] h-[2.2rem] leading-[2.2rem] z-[1] transition-all duration-[0.3s] ease-in-out opacity-0 text-[#343f52] shadow-[0_0.25rem_0.75rem_rgba(30,34,40,0.02)] text-[1rem] flex items-center justify-center rounded-[100%] right-0 bottom-4 bg-[rgba(255,255,255,.7)] hover:bg-[rgba(255,255,255,.9)] hover:!text-[#343f52] group-hover:opacity-100 group-hover:right-[1rem]" href="./assets/img/photos/shs2@2x.jpg" data-glightbox data-gallery="product-group"><i class="uil uil-focus-add before:content-['\eb22']"></i></a></figure>
                            </div>
                            <!--/.swiper-slide -->
                        </div>
                        <!--/.swiper-wrapper -->
                    </div>
                    <!-- /.swiper -->
                    <!-- /.swiper -->
                </div>
                <!-- /.swiper-container -->
            </div>
            <!-- /column -->
            <div class="xl:w-6/12 lg:w-6/12 w-full flex-[0_0_auto] px-[15px] xl:px-[35px] lg:px-[20px] mt-[40px] max-w-full">
                <div class="post-header mb-5">
                    <h2 class="post-title text-[calc(1.285rem_+_0.42vw)] font-bold xl:text-[1.6rem] leading-[1.3]"><a href="./shop-product.html" class="text-[#343f52] hover:text-[#3f78e0]">@Model.Organization.Name</a></h2>
                </div>
                <!-- /.post-header -->
                <p class="!mb-6">@Model.Organization.Website.</p>
                <p class="!mb-6">@Model.Organization.Overview.</p>
                <p class="!mb-6">@Model.Organization.AboutUs.</p>
                <ul class="list-group">
                    <li class="list-group-item"><strong>Contact Numer:</strong> @Model.Organization.Contact</li>
                    <li class="list-group-item"><strong>Email:</strong> @Model.Organization.Email</li>
                    <li class="list-group-item"><strong>Address:</strong> @Model.Organization.Address</li>
                    <li class="list-group-item"><strong>Country:</strong> @Model.Organization.Country</li>
                </ul>

                <!-- /form -->
            </div>
            <!-- /column -->
        </div>
        <!-- /.row -->
        <ul class="nav nav-tabs nav-tabs-basic mt-[70px]">
            <li class="nav-item">
                <a class="nav-link active" data-bs-toggle="tab" href="#tab1-1">Courses</a>
            </li>


        </ul>
        <!-- /.nav-tabs -->
        <div class="tab-content mt-0 md:!mt-5">
            <div class="tab-pane fade show active" id="tab1-1">
                @foreach (var course in Model.Courses)
                {
                    <a asp-controller="Course" asp-action="DetailsView" asp-route-id="@course.Id">
                        <div class="project item group md:w-6/12 lg:w-6/12 xl:w-4/12 w-full flex-[0_0_auto] xl:px-[20px] lg:px-[20px] md:px-[20px] px-[15px] mt-[50px] xl:mt-[80px] lg:mt-[80px] md:mt-[80px] max-w-full">
                            <figure class="!rounded-[.4rem] !mb-6">
                                <img src="~/uploads/@course.CourseImagePath" srcset="~/uploads/@course.CourseImagePath 2x" alt="image">
                                <a asp-controller="Course" asp-action="DetailsView" asp-route-id="@course.Id" class="item-cart opacity-0 absolute bottom-[-2rem] w-full h-auto text-white text-center transition-all duration-[0.3s] ease-in-out text-[0.85rem] flex items-center justify-center font-bold m-0 p-[0.8rem] left-0 bg-[rgba(38,43,50,.8)] hover:bg-[rgba(38,43,50,.9)] hover:!text-white group-hover:opacity-100 group-hover:bottom-0"><i class="uil uil-shopping-bag font-normal mt-[-0.05rem] mr-1 before:content-['\ecba']"></i> Details </a>
                                <span class=" flex items-center justify-center font-bold leading-[1.7] tracking-[-0.01rem] rounded-[100%] !bg-[rgba(209,107,134)] !opacity-100 text-white !w-[2.5rem] !h-[2.5rem] absolute uppercase text-[0.65rem]" style="top: 1rem; left: 1rem;"><span>New!</span></span>
                            </figure>
                            <div class="post-header">
                                <div class="flex flex-row items-center justify-between mb-2">
                                    <div class="uppercase tracking-[0.02rem] text-[0.7rem] font-bold text-[#9499a3] !mb-0">@course.CourseTitle</div>
                                    <span class="ratings  inline-block relative w-20 h-[0.8rem] text-[0.9rem] leading-none before:text-[rgba(38,43,50,0.1)] after:inline-block after:not-italic after:font-normal after:absolute after:text-[#fcc032] after:content-['\2605\2605\2605\2605\2605'] after:overflow-hidden after:left-0 after:top-0 before:inline-block before:not-italic before:font-normal before:absolute before:text-[#fcc032] before:content-['\2605\2605\2605\2605\2605'] before:overflow-hidden before:left-0 before:top-0 five"></span>
                                </div>
                                <h2 class="post-title h3 text-[1.1rem]"><span class="text-[#343f52] hover:text-[#3f78e0]"> @course.Institution</span></h2>
                                <h2 class="post-title h3 text-[1.1rem]"><span class="text-[#343f52] hover:text-[#3f78e0]"> @course.Category</span></h2>
                                <p class="price !m-0"><del class="text-[#9499a3]"><span class="amount">@course.CourseFee /-</span></del> <ins class="no-underline text-[#e2626b]"><span class="amount">@course.Duration Hours</span></ins></p>
                            </div>
                            <!-- /.post-header -->
                        </div>
                    </a>
                }
            </div>

            <!--/.tab-pane -->
        </div>
        <!-- /.tab-content -->
    </div>
