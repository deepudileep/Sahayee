@model IEnumerable<Sahayee.Models.DB.Jobs>

<table class="table">
    <thead>
        <tr>
            <th>Job Title</th>
            <th>CompanyName</th>
            <th>Location</th>
            <th>Application Deadline</th>
            <th>Contact Email</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var job in Model)
        {
            <tr>
                <td>@job.JobTitle</td>
                <td>@job.CompanyName</td>
                <td>@job.JobLocation</td>
                <td>@job.ApplicationDeadline</td>
                <td>@job.ContactPersonEmail</td>
                <td>
                    <a href="/Job/AdminApplicantDetails?jobAId=@job.Id" class="btn btn-primary ">Details</a>
                    <a href="/Job/Create?id=@job.Id" class="btn btn-primary">Edit</a>
                    @* <button class="btn btn-danger" onclick="openDeleteModal('@job.Id')">Delete</button>*@
                </td>
            </tr>
        }
    </tbody>
</table>
