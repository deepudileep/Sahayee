@model Sahayee.Models.ViewModel.JobApplicationDetailsViewModel


<div class=" mt-5">
    <div class="row">
        <!-- Filter Panel -->
        <aside class="col-lg-3 col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3">Filter Jobs</h5>
                    <form>
                        <!-- Key/Title Filter -->
                        <div class="mb-3">
                            <label for="category" class="form-label">Key, Title</label>
                            <input type="text" id="category" name="category" class="form-control" placeholder="Search by title or keyword">
                        </div>
                        <!-- Location Filter -->
                        <div class="mb-3">
                            <label for="location" class="form-label">Job Types</label>
                            <select class="form-select me-2" id="JobTypes" style="width: auto;">
                                @foreach (var position in Model.JobTypes)
                                {
                                    <option value="@position.Id">@position.Name</option>
                                }
                            </select>
                        </div>
                        <!-- Experience Level Filter -->
                        <div class="mb-3">
                            <label for="experience" class="form-label">Companies</label>
                            <select class="form-select me-2" id="Companies" style="width: auto;">
                                @foreach (var position in Model.Companies)
                                {
                                    <option value="@position.Id">@position.Name</option>
                                }
                            </select>
                        </div>
                        <!-- Department Filter -->
                        <div class="mb-3">
                            <label for="department" class="form-label">Locations</label>
                            <select class="form-select me-2" id="locationFilter" style="width: auto;">
                                @foreach (var location in Model.Locations)
                                {
                                    <option value="@location.Id">@location.Name</option>
                                }
                            </select>
                        </div>
                        <!-- Submit Button -->
                        <div class="d-grid">
                            <button type="button" class="btn btn-primary" onclick="filterJobs()">Apply Filters</button>
                        </div>
                    </form>
                </div>
            </div>
        </aside>

        <!-- Job Listings -->
        <section class="col-lg-9 col-md-8">           
            <div class="row g-3">
                <div id="jobTableContainer">
                    @await Html.PartialAsync("_JobApplicationDetailsPartial", Model)
                </div>

            </div>
        </section>
    </div>
</div>
<script>
    function filterJobs() {

        const JobTypes = document.getElementById('JobTypes').value;
        const Companies = document.getElementById('Companies').value;
        const locationFilter = document.getElementById('locationFilter').value;

        fetch(`/Job/ReloadJobs?JobType=${JobTypes}&Company=${Companies}&location=${locationFilter}`, {
            method: 'GET',
            headers: {
                'Accept': 'text/html'
            }
        })
            .then(response => response.text())
            .then(html => {
                document.getElementById('jobTableContainer').innerHTML = html;
            })
            .catch(error => console.error('Error fetching jobs:', error));
    }


</script>