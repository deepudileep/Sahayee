@model Sahayee.Models.ViewModel.JobFilterViewModel

@if (Model.Jobs.Any())
{
    foreach (var job in Model.Jobs)
    {
        <div class="col-lg-12 col-md-12">
            <div class="card" style="width: 18rem;">
                <img src="https://via.placeholder.com/150" class="card-img-top">
                <div class="card-body">
                    <h5 class="card-title">@job.JobTitle</h5>
                    <p class="card-text">
                        <strong>Company Name:</strong> @job.CompanyName<br>
                        <strong>Job Type:</strong> @job.JobType<br>
                        <strong>Location:</strong> @job.JobLocation<br>
                        <strong>Application Deadline:</strong> @job.ApplicationDeadline<br>
                    </p>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <a asp-controller="Job" asp-action="DetailsView" asp-route-id="@job.Id" class="btn btn-primary">View Details</a>
                    </div>
                </div>
            </div>            
        </div>
    }
}
else
{
    <div class="col-12">
        <div class="alert alert-warning" role="alert">
            No jobs found based on the applied filters.
        </div>
    </div>
}
